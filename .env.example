# ---------------------------------------------------------------------------
# Data Source Switch
# Dibaca oleh src/config/data-source.config.ts
#   true      → seluruh dashboard memakai mock di src/mocks/** (default dev)
#   false     → memanggil Appwrite lewat *-appwrite.service.ts
#   undefined → dianggap true (mock ON) supaya clone baru langsung jalan
# Default staging akan diubah ke false pada task s5-mock-off.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK_DATA=false

# Role identitas sintetis saat mock ON. Dibaca src/services/auth/session.service.ts.
# Sejak s6-guard-redirect, RoleGuard tidak lagi di-bypass di mode mock — jadi
# dashboard yang terbuka mengikuti role ini. Login lewat /login menimpanya
# (disimpan di localStorage) dan logout membersihkannya.
#   umkm | creator | admin — nilai lain diabaikan, fallback "umkm".
NEXT_PUBLIC_MOCK_ROLE=umkm

# ---------------------------------------------------------------------------
# Autentikasi — dibaca src/config/auth.config.ts
# Google OAuth default MATI: provider-nya belum dikonfigurasi di konsol Appwrite
# (handoff-auth-sprint6.md §A-3). Selama false, tombol "Login dengan Google"
# tidak dirender sama sekali, bukan dirender lalu error.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false

# ---------------------------------------------------------------------------
# External Standalone Applications
# ---------------------------------------------------------------------------
# URL origin aplikasi standalone Admin.
# Staging:    https://admin-staging.marketiv.id
# Production: https://admin.marketiv.id
NEXT_PUBLIC_ADMIN_APP_URL=https://admin-staging.marketiv.id

# ---------------------------------------------------------------------------
# Appwrite — Public (Browser-Safe) Variables
# Aman diekspos ke browser lewat prefix NEXT_PUBLIC_.
# Nilai nyata ada di 00_BACKEND/appwrite.config.json.
# JANGAN menambahkan API key atau kredensial server di sini.
# Staging user Site: NEXT_PUBLIC_APPWRITE_ENDPOINT=https://api-staging.marketiv.id/v1
# Admin memakai hostname API terpisah; lihat admin/.env.example.
# Project/database staging tetap sama di kedua aplikasi.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# Bucket per kegunaan (project punya 7 bucket, bukan satu).
# Kosongkan untuk memakai default di src/lib/appwrite/config.ts.
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=
NEXT_PUBLIC_APPWRITE_BUCKET_AVATARS=
NEXT_PUBLIC_APPWRITE_BUCKET_LOGOS=
NEXT_PUBLIC_APPWRITE_BUCKET_PORTFOLIOS=
NEXT_PUBLIC_APPWRITE_BUCKET_CAMPAIGN_ASSETS=
NEXT_PUBLIC_APPWRITE_BUCKET_DELIVERABLES=
NEXT_PUBLIC_APPWRITE_BUCKET_FRAUD_EVIDENCE=

# ---------------------------------------------------------------------------
# Appwrite — Server-Only Variables (NEVER expose to browser)
# Used only in Appwrite Functions or secure Server Actions.
# ---------------------------------------------------------------------------
# APPWRITE_API_KEY=           # Server SDK elevated key — server only

# ---------------------------------------------------------------------------
# OpenRouter API Configuration
# Cara mendapatkan key:
# 1. Daftar/Login di https://openrouter.ai/
# 2. Masuk ke halaman https://openrouter.ai/settings/keys
# 3. Klik "Create Key" dan salin token tersebut ke OPENROUTER_API_KEY
# Atau, silakan minta key langsung kepada partner pengembangan Anda.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Vertex AI Configuration (PRIMARY PROVIDER - GCP Free Credit $300)
# Cara mendapatkan kredensial Vertex AI:
# 1. Buat project di Google Cloud Platform (https://console.cloud.google.com/)
# 2. Aktifkan Vertex AI API di project tersebut.
# 3. Buat Service Account dan unduh key dalam format JSON.
# 4. Ekstrak data dari file JSON tersebut untuk mengisi variabel di bawah
#    (project_id, client_email, dan private_key).
# Atau, silakan minta file service account key (atau nilainya) kepada partner Anda.
# ---------------------------------------------------------------------------
VERTEX_AI_PROJECT_ID=
VERTEX_AI_CLIENT_EMAIL=
VERTEX_AI_PRIVATE_KEY=
VERTEX_AI_LOCATION=
VERTEX_AI_MODEL=

# ---------------------------------------------------------------------------
# Midtrans Snap (pembayaran escrow campaign — s3-wizard-real 6b)
# Client key aman di browser; SERVER KEY hanya di Function create-payment
# (MIDTRANS_SERVER_KEY), jangan pernah ditaruh di NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# ---------------------------------------------------------------------------
# Sentry Error Monitoring & Tracking
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# ---------------------------------------------------------------------------
# Supabase (migrasi Appwrite → Supabase, Fase 2)
# Dibaca src/lib/supabase/{client,server,admin}.ts. Selama migrasi app masih
# memakai Appwrite; env ini baru wajib saat sebuah fitur pindah ke Supabase.
# Nilai: Dashboard Supabase → Project Settings → API (staging: marketiv-staging).
# Lokal: jalankan `supabase start`, lalu salin dari `supabase status`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key: aman di browser, semua akses dibatasi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: MELEWATI RLS. Server only — JANGAN pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Secret bersama untuk endpoint /api/cron/* yang dipanggil pg_cron (via pg_net).
# Buat dengan: openssl rand -hex 32
CRON_SECRET=
